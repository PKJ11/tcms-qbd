generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AppRole {
  ADMINISTRATOR
  VIEWER
  TRAINER
  TRAINEE
  GUEST_TRAINER
  CONTRACTUAL_EMPLOYEE
}

enum TrainingType {
  MATERIAL_MCQ // material + assessment — completes only after passing
  MATERIAL_ONLY // completes when the material has been opened/read
  ACKNOWLEDGEMENT_ONLY // completes when the trainee clicks acknowledge
}

enum TrainingTrigger {
  INDUCTION
  SCHEDULE
  REFRESHER
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  FAILED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum FileType {
  PPT
  PDF
  VIDEO
  OTHER
}

enum AssessmentType {
  MCQ
  ORAL
}

enum AssessmentOutcome {
  PASS
  FAIL
  NEEDS_RETRAINING
}

enum QualStatus {
  INITIATED
  IN_PROGRESS
  APPROVED
  EXPIRED
  REVOKED
}

enum QualOutcome {
  COMPETENT
  NOT_YET_COMPETENT
}

enum TechniqueType {
  METHOD
  INSTRUMENT
  TECHNIQUE
}

enum SignatoryRole {
  QC_TRAINER
  QA_TRAINER
}

enum SignatoryStatus {
  PENDING
  SIGNED
  REJECTED
}

enum NotificationType {
  ASSIGNMENT
  DUE_SOON
  OVERDUE
  FAILED
  RETRAINING
  QUALIFICATION_EXPIRY
  PASSWORD_RESET
  DOCUMENT_UPDATED
  ASSIGNMENT_WITHDRAWN
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  DEACTIVATE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  UPLOAD
  GENERATE
  ASSIGN
  REVOKE
}

enum RefresherTriggerType {
  PLANNED
  DEVIATION
  INCIDENT
}

enum RefresherStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum TestPhase {
  IQ
  OQ
  PQ
  RT
}

enum TestStatus {
  NOT_EXECUTED
  PASS
  FAIL
  BLOCKED
}

enum ValidationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
  LOCKED
}

// ─────────────────────────────────────────────
// FOUNDATION MODELS
// ─────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  units       Unit[]
  persons     Person[]
  techniques  Technique[]
  topicScopes TopicScope[]
  topicGroups TopicGroup[]

  @@map("departments")
}

model Unit {
  id           String   @id @default(cuid())
  name         String
  code         String
  departmentId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department  Department   @relation(fields: [departmentId], references: [id])
  sections    Section[]
  persons     Person[]
  topicScopes TopicScope[]
  topicGroups TopicGroup[]

  @@unique([departmentId, code])
  @@map("units")
}

model Section {
  id        String   @id @default(cuid())
  name      String
  code      String
  unitId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  unit        Unit         @relation(fields: [unitId], references: [id])
  persons     Person[]
  topicScopes TopicScope[]
  topicGroups TopicGroup[]

  @@unique([unitId, code])
  @@map("sections")
}

model PersonRole {
  id       String  @id @default(cuid())
  personId String
  role     AppRole

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, role])
  @@map("person_roles")
}

// Stores previous password hashes so a person cannot reuse any of their
// last 3 passwords (current passwordHash + the 2 most recent rows here).
model PasswordHistory {
  id           String   @id @default(cuid())
  personId     String
  passwordHash String
  createdAt    DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("password_history")
}

// Single-row, admin-configurable password policy. All password rules
// (expiry, lockout threshold, min length, reuse history) are read from
// here at runtime instead of hard-coded constants.
model PasswordPolicy {
  id                   String   @id @default(cuid())
  key                  String   @unique @default("default")
  policyName           String   @default("Password Policy")
  authMode             String   @default("DB")
  passwordExpiryDays   Int      @default(45)
  failedAttemptLimit   Int      @default(3)
  minPasswordLength    Int      @default(8)
  passwordHistoryCount Int      @default(3)
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("password_policies")
}

model Person {
  id                        String    @id @default(cuid())
  employeeId                String    @unique
  name                      String
  email                     String?   @unique
  passwordHash              String
  mustChangePassword        Boolean   @default(true)
  passwordChangedAt         DateTime  @default(now())
  failedLoginAttempts       Int       @default(0)
  isLocked                  Boolean   @default(false)
  lockedAt                  DateTime?
  designation               String
  isActive                  Boolean   @default(true)
  joiningDate               DateTime?
  lastLoginAt               DateTime?
  departmentId              String
  unitId                    String
  sectionId                 String? // optional — not all units have sections
  managerId                 String?
  flaggedForJobReassignment Boolean   @default(false)
  flaggedAt                 DateTime?
  flagReason                String?
  flagTopicId               String?
  flagCycleCount            Int?
  resolvedAt                DateTime?
  resolvedById              String?
  resolutionAction          String?
  resolutionNotes           String?
  createdById               String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Relations
  createdBy                   Person?               @relation("personCreator", fields: [createdById], references: [id])
  personsCreated              Person[]              @relation("personCreator")
  roles                       PersonRole[]
  passwordHistory             PasswordHistory[]
  department                  Department            @relation(fields: [departmentId], references: [id])
  unit                        Unit                  @relation(fields: [unitId], references: [id])
  section                     Section?              @relation(fields: [sectionId], references: [id])
  manager                     Person?               @relation("manages", fields: [managerId], references: [id])
  subordinates                Person[]              @relation("manages")
  trainingAssignments         TrainingAssignment[]
  assessmentAttempts          AssessmentAttempt[]
  qualificationRecords        QualificationRecord[] @relation("qualifiedPerson")
  supervisedQualifications    QualificationRecord[] @relation("supervisor")
  initiatedQualifications     QualificationRecord[] @relation("initiator")
  signatoryEntries            SignatoryEntry[]
  assignedSignatories         SignatoryEntry[]      @relation("SignatoryAssignedTo")
  signatoryAssignmentsMade    SignatoryEntry[]      @relation("SignatoryAssignedBy")
  uploadedDocuments           ScannedDocument[]
  issuedCertificates          Certificate[]         @relation("issuer")
  personCertificates          Certificate[]         @relation("certPerson")
  notifications               Notification[]
  auditLogs                   AuditLog[]
  refresherRaisedBy           RefresherTrigger[]    @relation("raisedBy")
  refresherPersons            RefresherTrigger[]    @relation("refresherPerson")
  uploadedContent             MaterialVersion[]     @relation("contentUploader")
  approvedContent             MaterialVersion[]     @relation("contentApprover")
  questionBankVersionsCreated QuestionBankVersion[] @relation("questionBankVersionCreator")
  createdTopics               TrainingTopic[]
  createdAssignments          TrainingAssignment[]  @relation("assignedBy")
  trainerCertificates         TrainerCertificate[]  @relation("trainerCertPerson")
  issuedTrainerCertificates   TrainerCertificate[]  @relation("trainerCertIssuer")
  revokedTrainerCertificates  TrainerCertificate[]  @relation("trainerCertRevoker")
  validationRunsExecuted      ValidationRun[]       @relation("valRunExecutor")
  validationRunsApproved      ValidationRun[]       @relation("valRunApprover")
  testResultsExecuted         TestResult[]          @relation("testResultExecutor")
  topicAccessGranted          TopicCollaborator[]   @relation("topicCollaboratorPerson")
  topicAccessAddedBy          TopicCollaborator[]   @relation("topicCollaboratorAddedBy")
  topicGroupsCreated          TopicGroup[]          @relation("topicGroupCreator")
  workDrafts                  WorkDraft[]

  @@map("persons")
}

// ─────────────────────────────────────────────
// TRAINING TOPIC + CONTENT
// ─────────────────────────────────────────────

model TrainingTopic {
  id           String       @id @default(cuid())
  name         String
  description  String?
  // e.g. "QbD-QC-SOP-067, Ver.No. 04" — the governing SOP number + version
  // this training covers. Shown under the topic name on printed reports
  // (Training Matrix); optional since not every topic maps to one SOP.
  sopReference String?
  trainingType TrainingType @default(MATERIAL_MCQ)
  isActive     Boolean      @default(true)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy    Person               @relation(fields: [createdById], references: [id])
  topicScopes  TopicScope[]
  materials    TrainingMaterial[]
  questionBank QuestionBank?
  assignments  TrainingAssignment[]
  refreshers   RefresherTrigger[]
  collaborators TopicCollaborator[]
  groupItems   TopicGroupItem[]

  @@map("training_topics")
}

// Grants a Trainer/Guest Trainer who did NOT create the topic permission to
// upload/manage its training material and create/manage its assessment
// questions. Only the topic's creator can manage this list — see
// assertTopicOwner() in modules/topics/access.ts.
model TopicCollaborator {
  id        String   @id @default(cuid())
  topicId   String
  personId  String
  addedById String
  createdAt DateTime @default(now())

  topic   TrainingTopic @relation(fields: [topicId], references: [id])
  person  Person        @relation("topicCollaboratorPerson", fields: [personId], references: [id])
  addedBy Person        @relation("topicCollaboratorAddedBy", fields: [addedById], references: [id])

  @@unique([topicId, personId])
  @@map("topic_collaborators")
}

// Topic → Department/Unit/Section scope (compulsory-training targeting +
// induction auto-assign). unitId/sectionId narrow the scope when set;
// department-only (unitId/sectionId both null) means "whole department".
model TopicScope {
  id           String   @id @default(cuid())
  topicId      String
  departmentId String
  unitId       String?
  sectionId    String?
  createdAt    DateTime @default(now())

  topic      TrainingTopic @relation(fields: [topicId], references: [id])
  department Department    @relation(fields: [departmentId], references: [id])
  unit       Unit?         @relation(fields: [unitId], references: [id])
  section    Section?      @relation(fields: [sectionId], references: [id])

  @@map("topic_scopes")
}

// Trainer-curated bundle of topics for their own unit ("their team") —
// built via the drag-and-drop "Topic Group" builder. A trainer may only
// create groups scoped to their own department+unit; sectionId is optional
// and narrows a group to a single section for extra/section-specific
// training on top of the unit-wide groups (sectionId null = whole unit).
// Every active person who joins matches every group where sectionId is
// null OR equals their own section — so unit-wide + their section's extra
// groups both apply. Auto-assigned as INDUCTION training, due
// `joiningDate + 1 month`. See autoAssignTopicGroupInduction() in
// modules/assignments/actions.ts.
model TopicGroup {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  unitId       String
  sectionId    String?
  createdById  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department       @relation(fields: [departmentId], references: [id])
  unit       Unit             @relation(fields: [unitId], references: [id])
  section    Section?         @relation(fields: [sectionId], references: [id])
  createdBy  Person           @relation("topicGroupCreator", fields: [createdById], references: [id])
  items      TopicGroupItem[]

  @@map("topic_groups")
}

model TopicGroupItem {
  id        String   @id @default(cuid())
  groupId   String
  topicId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  group TopicGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic TrainingTopic @relation(fields: [topicId], references: [id])

  @@unique([groupId, topicId])
  @@map("topic_group_items")
}

model TrainingMaterial {
  id             String        @id @default(cuid())
  title          String
  topicId        String
  currentVersion Int           @default(1)
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  topic                 TrainingTopic                    @relation(fields: [topicId], references: [id])
  versions              MaterialVersion[]
  materialConfirmations AssignmentMaterialConfirmation[]
  assignmentVersionPins AssignmentMaterialVersion[]

  @@map("training_materials")
}

model TrainerCertificate {
  id            String    @id @default(cuid())
  personId      String
  issuedById    String
  certNumber    String    @unique
  basis         String
  isActive      Boolean   @default(true)
  issuedAt      DateTime  @default(now())
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?

  person    Person  @relation("trainerCertPerson", fields: [personId], references: [id])
  issuedBy  Person  @relation("trainerCertIssuer", fields: [issuedById], references: [id])
  revokedBy Person? @relation("trainerCertRevoker", fields: [revokedById], references: [id])

  @@map("trainer_certificates")
}

model MaterialVersion {
  id            String        @id @default(cuid())
  materialId    String
  versionNo     Int
  versionLabel  String
  fileUrl       String
  fileName      String
  fileType      FileType
  changeSummary String
  status        ContentStatus @default(DRAFT)
  uploadedById  String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())

  material       TrainingMaterial            @relation(fields: [materialId], references: [id])
  uploadedBy     Person                      @relation("contentUploader", fields: [uploadedById], references: [id])
  approvedBy     Person?                     @relation("contentApprover", fields: [approvedById], references: [id])
  assignmentPins AssignmentMaterialVersion[]

  @@unique([materialId, versionNo])
  @@map("material_versions")
}

// ─────────────────────────────────────────────
// TRAINING ASSIGNMENT
// ─────────────────────────────────────────────

model TrainingAssignment {
  id                    String           @id @default(cuid())
  personId              String
  topicId               String
  trigger               TrainingTrigger
  status                AssignmentStatus @default(NOT_STARTED)
  assignedById          String
  dueDate               DateTime
  startedAt             DateTime?
  viewedAt              DateTime?
  completedAt           DateTime?
  acknowledged          Boolean          @default(false)
  needIdentifiedById    String?
  needBasis             String?
  questionBankVersionId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  person                Person                           @relation(fields: [personId], references: [id])
  topic                 TrainingTopic                    @relation(fields: [topicId], references: [id])
  assignedBy            Person                           @relation("assignedBy", fields: [assignedById], references: [id])
  questionBankVersion   QuestionBankVersion?             @relation(fields: [questionBankVersionId], references: [id])
  attempts              AssessmentAttempt[]
  materialConfirmations AssignmentMaterialConfirmation[]
  materialVersions      AssignmentMaterialVersion[]

  @@map("training_assignments")
}

model AssignmentMaterialConfirmation {
  id           String   @id @default(cuid())
  assignmentId String
  materialId   String
  confirmedAt  DateTime @default(now())

  assignment TrainingAssignment @relation(fields: [assignmentId], references: [id])
  material   TrainingMaterial   @relation(fields: [materialId], references: [id])

  @@unique([assignmentId, materialId])
  @@map("assignment_material_confirmations")
}

// Pins which MaterialVersion was current for each of the topic's materials at
// the moment a TrainingAssignment was created — kept separate from
// AssignmentMaterialConfirmation (which tracks the trainee's read/confirm
// event) so this is purely "what version was used", set once and never moved.
model AssignmentMaterialVersion {
  id                String   @id @default(cuid())
  assignmentId      String
  materialId        String
  materialVersionId String
  createdAt         DateTime @default(now())

  assignment      TrainingAssignment @relation(fields: [assignmentId], references: [id])
  material        TrainingMaterial   @relation(fields: [materialId], references: [id])
  materialVersion MaterialVersion    @relation(fields: [materialVersionId], references: [id])

  @@unique([assignmentId, materialId])
  @@map("assignment_material_versions")
}

// ─────────────────────────────────────────────
// ASSESSMENT
// ─────────────────────────────────────────────

model QuestionBank {
  id                  String         @id @default(cuid())
  topicId             String         @unique
  passingPercentage   Float          @default(80)
  questionsPerAttempt Int            @default(10)
  maxAttempts         Int            @default(3)
  isActive            Boolean        @default(true)
  assessmentType      AssessmentType @default(MCQ)
  currentVersionId    String?        @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  topic          TrainingTopic              @relation(fields: [topicId], references: [id])
  currentVersion QuestionBankVersion?       @relation("currentVersion", fields: [currentVersionId], references: [id])
  versions       QuestionBankVersion[]      @relation("bankVersions")
  workingSet     QuestionBankWorkingSet?
  attempts       AssessmentAttempt[]

  @@map("question_banks")
}

// Immutable snapshot of a question bank's question set. Created only when a
// trainer clicks "Save Changes" on the staged working set — never mutated
// afterwards, so past assignments/attempts always point at exactly what was
// used at the time.
model QuestionBankVersion {
  id               String   @id @default(cuid())
  bankId           String
  versionNo        Int
  versionLabel     String
  basedOnVersionId String?
  createdById      String
  createdAt        DateTime @default(now())

  bank            QuestionBank             @relation("bankVersions", fields: [bankId], references: [id])
  basedOn         QuestionBankVersion?     @relation("versionLineage", fields: [basedOnVersionId], references: [id])
  derivedVersions QuestionBankVersion[]    @relation("versionLineage")
  createdBy       Person                   @relation("questionBankVersionCreator", fields: [createdById], references: [id])
  banksCurrent    QuestionBank?            @relation("currentVersion")
  questions       Question[]
  attempts        AssessmentAttempt[]
  assignments     TrainingAssignment[]
  workingSetBase  QuestionBankWorkingSet[]

  @@unique([bankId, versionNo])
  @@map("question_bank_versions")
}

// The trainer's in-progress editing session for a bank — never read by the
// assessment-taking flow. Add/archive/restore only touch this table; nothing
// here is real until "Save Changes" materializes it into a QuestionBankVersion.
model QuestionBankWorkingSet {
  id            String   @id @default(cuid())
  bankId        String   @unique
  baseVersionId String?
  updatedById   String
  updatedAt     DateTime @updatedAt

  bank  QuestionBank                 @relation(fields: [bankId], references: [id])
  base  QuestionBankVersion?         @relation(fields: [baseVersionId], references: [id])
  items QuestionBankWorkingSetItem[]

  @@map("question_bank_working_sets")
}

model QuestionBankWorkingSetItem {
  id               String  @id @default(cuid())
  workingSetId     String
  sourceQuestionId String? // null = newly added and not yet saved
  questionText     String
  optionA          String
  optionB          String
  optionC          String? // 2-4 options per question — C/D optional
  optionD          String?
  correctAnswer    String
  isActive         Boolean @default(true) // staged archive/restore toggle

  workingSet QuestionBankWorkingSet @relation(fields: [workingSetId], references: [id])

  @@map("question_bank_working_set_items")
}

model Question {
  id            String   @id @default(cuid())
  bankVersionId String
  questionText  String
  optionA       String
  optionB       String
  optionC       String? // 2-4 options per question — C/D optional
  optionD       String?
  correctAnswer String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankVersion QuestionBankVersion @relation(fields: [bankVersionId], references: [id])

  @@map("questions")
}

model AssessmentAttempt {
  id            String            @id @default(cuid())
  personId      String
  bankId        String
  bankVersionId String
  assignmentId  String
  attemptNo     Int
  score         Float
  outcome       AssessmentOutcome
  answers       Json
  startedAt     DateTime
  submittedAt   DateTime
  createdAt     DateTime          @default(now())

  person      Person              @relation(fields: [personId], references: [id])
  bank        QuestionBank        @relation(fields: [bankId], references: [id])
  bankVersion QuestionBankVersion @relation(fields: [bankVersionId], references: [id])
  assignment  TrainingAssignment  @relation(fields: [assignmentId], references: [id])

  @@map("assessment_attempts")
}

// ─────────────────────────────────────────────
// REFRESHER TRAINING
// ─────────────────────────────────────────────

model RefresherTrigger {
  id            String               @id @default(cuid())
  personId      String
  topicId       String
  triggerType   RefresherTriggerType
  status        RefresherStatus      @default(PENDING)
  justification String
  raisedById    String
  dueDate       DateTime
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  person   Person        @relation("refresherPerson", fields: [personId], references: [id])
  topic    TrainingTopic @relation(fields: [topicId], references: [id])
  raisedBy Person        @relation("raisedBy", fields: [raisedById], references: [id])

  @@map("refresher_triggers")
}

// ─────────────────────────────────────────────
// SCIENTIST QUALIFICATION
// ─────────────────────────────────────────────

model Technique {
  id           String        @id @default(cuid())
  name         String
  code         String        @unique
  type         TechniqueType
  departmentId String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department     Department            @relation(fields: [departmentId], references: [id])
  qualifications QualificationRecord[]

  @@map("techniques")
}

model QualificationRecord {
  id                String       @id @default(cuid())
  personId          String
  techniqueId       String
  status            QualStatus   @default(INITIATED)
  outcome           QualOutcome?
  performedOn       DateTime?
  supervisorId      String?
  initiatedById     String
  initiatedAt       DateTime     @default(now())
  approvedAt        DateTime?
  expiryDate        DateTime?
  requalificationOf String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  person           Person                @relation("qualifiedPerson", fields: [personId], references: [id])
  technique        Technique             @relation(fields: [techniqueId], references: [id])
  supervisor       Person?               @relation("supervisor", fields: [supervisorId], references: [id])
  initiatedBy      Person                @relation("initiator", fields: [initiatedById], references: [id])
  previousQual     QualificationRecord?  @relation("requalification", fields: [requalificationOf], references: [id])
  nextQuals        QualificationRecord[] @relation("requalification")
  signatories      SignatoryEntry[]
  scannedDocuments ScannedDocument[]
  certificate      Certificate?

  @@map("qualification_records")
}

model SignatoryEntry {
  id              String          @id @default(cuid())
  qualificationId String
  stepOrder       Int
  requiredRole    SignatoryRole
  signedById      String?
  signedAt        DateTime?
  justification   String?
  status          SignatoryStatus @default(PENDING)
  assignedToId    String?
  assignedById    String?
  assignedAt      DateTime?
  createdAt       DateTime        @default(now())

  qualification QualificationRecord @relation(fields: [qualificationId], references: [id])
  signedBy      Person?             @relation(fields: [signedById], references: [id])
  assignedTo    Person?             @relation("SignatoryAssignedTo", fields: [assignedToId], references: [id])
  assignedBy    Person?             @relation("SignatoryAssignedBy", fields: [assignedById], references: [id])

  @@unique([qualificationId, stepOrder])
  @@map("signatory_entries")
}

model ScannedDocument {
  id              String   @id @default(cuid())
  qualificationId String
  fileUrl         String
  fileName        String
  fileType        String
  description     String
  uploadedById    String
  uploadedAt      DateTime @default(now())

  qualification QualificationRecord @relation(fields: [qualificationId], references: [id])
  uploadedBy    Person              @relation(fields: [uploadedById], references: [id])

  @@map("scanned_documents")
}

model Certificate {
  id              String    @id @default(cuid())
  certNumber      String    @unique
  qualificationId String    @unique
  personId        String
  issuedById      String
  issuedAt        DateTime  @default(now())
  fileUrl         String
  validUntil      DateTime?

  qualification QualificationRecord @relation(fields: [qualificationId], references: [id])
  person        Person              @relation("certPerson", fields: [personId], references: [id])
  issuedBy      Person              @relation("issuer", fields: [issuedById], references: [id])

  @@map("certificates")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id       String              @id @default(cuid())
  personId String
  type     NotificationType
  channel  NotificationChannel
  title    String
  message  String
  isRead   Boolean             @default(false)
  sentAt   DateTime            @default(now())
  readAt   DateTime?

  person Person @relation(fields: [personId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT TRAIL
// ─────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(cuid())
  userId        String
  action        AuditAction
  module        String
  recordId      String
  recordType    String
  beforeValue   Json?
  afterValue    Json?
  justification String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  user Person @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// VALIDATION SUPPORT
// ─────────────────────────────────────────────

model ValidationRun {
  id           String           @id @default(cuid())
  phase        TestPhase
  version      String
  environment  String
  status       ValidationStatus @default(PLANNED)
  startedAt    DateTime?
  completedAt  DateTime?
  executedById String?
  approvedById String?
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())

  executedBy  Person?      @relation("valRunExecutor", fields: [executedById], references: [id])
  approvedBy  Person?      @relation("valRunApprover", fields: [approvedById], references: [id])
  testResults TestResult[]

  @@map("validation_runs")
}

model TestCase {
  id          String    @id @default(cuid())
  ursId       String
  module      String
  phase       TestPhase
  title       String
  description String
  steps       String
  expected    String
  priority    String    @default("M")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  results TestResult[]

  @@map("test_cases")
}

model TestResult {
  id             String     @id @default(cuid())
  runId          String
  testCaseId     String
  status         TestStatus @default(NOT_EXECUTED)
  actualResult   String?
  defectNotes    String?
  executedById   String?
  executedAt     DateTime?
  screenshotUrls String[]
  createdAt      DateTime   @default(now())

  run        ValidationRun @relation(fields: [runId], references: [id])
  testCase   TestCase      @relation(fields: [testCaseId], references: [id])
  executedBy Person?       @relation("testResultExecutor", fields: [executedById], references: [id])

  @@unique([runId, testCaseId])
  @@map("test_results")
}

// ─────────────────────────────────────────────
// WORK DRAFTS
// ─────────────────────────────────────────────
// Transient, per-user autosave of in-progress form / staging state so that an
// automatic (or manual) logout does not throw away unsaved work. A draft is
// scratch state only — never a GxP record. Restoring one merely re-populates a
// form; the user still goes through the normal Save + justification step.
// One row per (user, draftKey); purged on real save, explicit discard, or after
// expiresAt (7 days).
model WorkDraft {
  id            String   @id @default(cuid())
  userId        String
  draftKey      String
  routePath     String
  schemaVersion Int      @default(1)
  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime

  user Person @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, draftKey])
  @@index([userId])
  @@index([expiresAt])
  @@map("work_drafts")
}
